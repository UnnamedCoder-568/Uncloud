{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Uncloud",
  "version": "0.2.0",
  "identifier": "com.uncloud.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Uncloud",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#212121"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "resources": {
      "../../sidecar/uncloud_engine/*.py": "engine/uncloud_engine/",
      "../../sidecar/uncloud_engine/agent/*.py": "engine/uncloud_engine/agent/",
      "../../sidecar/scripts/*.py": "engine/scripts/",
      "../../sidecar/pyproject.toml": "engine/pyproject.toml",
      "../../sidecar/README.md": "engine/README.md",
      "../../sidecar/uv.lock": "engine/uv.lock",
      "binaries/*": ""
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
