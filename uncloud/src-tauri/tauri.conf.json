{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Uncloud",
  "version": "0.3.0-test.2",
  "identifier": "com.uncloud.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Uncloud",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#212121"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A local-first AI studio",
    "longDescription": "Run chat, image, video, voice, and agent workflows on your own machine.",
    "homepage": "https://github.com/UnnamedCoder-568/Uncloud",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "resources": {
      "../../sidecar/README.md": "engine/README.md",
      "../../sidecar/pyproject.toml": "engine/pyproject.toml",
      "../../sidecar/scripts/acestep_runner.py": "engine/scripts/acestep_runner.py",
      "../../sidecar/scripts/vibevoice_hq_runner.py": "engine/scripts/vibevoice_hq_runner.py",
      "../../sidecar/scripts/vibevoice_runner.py": "engine/scripts/vibevoice_runner.py",
      "../../sidecar/uncloud_engine/*.py": "engine/uncloud_engine/",
      "../../sidecar/uncloud_engine/agent/*.py": "engine/uncloud_engine/agent/",
      "../../sidecar/uncloud_engine/core/*.py": "engine/uncloud_engine/core/",
      "../../sidecar/uncloud_engine/core/README.md": "engine/uncloud_engine/core/README.md",
      "../../sidecar/uncloud_engine/core/auth/*.py": "engine/uncloud_engine/core/auth/",
      "../../sidecar/uncloud_engine/core/integrations/*.py": "engine/uncloud_engine/core/integrations/",
      "../../sidecar/uncloud_engine/core/integrations/providers/*.py": "engine/uncloud_engine/core/integrations/providers/",
      "../../sidecar/uncloud_engine/core/mcp/*.py": "engine/uncloud_engine/core/mcp/",
      "../../sidecar/uncloud_engine/core/lan/*.py": "engine/uncloud_engine/core/lan/",
      "../../sidecar/uncloud_engine/core/models/*.py": "engine/uncloud_engine/core/models/",
      "../dist": "web",
      "../../sidecar/uncloud_engine/core/legal/*.py": "engine/uncloud_engine/core/legal/",
      "../../sidecar/uncloud_engine/core/legal/documents/*.md": "engine/uncloud_engine/core/legal/documents/",
      "../../sidecar/uncloud_engine/core/legal/documents/*.json": "engine/uncloud_engine/core/legal/documents/",
      "../../sidecar/uncloud_engine/core/legal/product/*.md": "engine/uncloud_engine/core/legal/product/",
      "../../sidecar/uncloud_engine/training/*.py": "engine/uncloud_engine/training/",
      "../../sidecar/uv.lock": "engine/uv.lock"
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
