.continue/
1ls
TestPrint.py
Option 1*

# --------------------------------------------------- fetched at build time
# uv is downloaded per-platform by CI; ~50 MB, never committed.
#
# binaries/ holds exactly ONE uv — the one matching the target being built —
# because tauri.conf globs binaries/* into the bundle. The per-architecture
# copies are staged from vendor/ and must live outside binaries/, or every
# build would ship all of them.
uncloud/src-tauri/binaries/uv
uncloud/src-tauri/binaries/uv.exe
uncloud/src-tauri/vendor/

